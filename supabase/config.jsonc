{
  "$schema": "https://supabase.com/schemas/config/v1.json",
  "project_id": "stockpilot-local",
  "api": {
    "enabled": true,
    "schemas": ["public", "graphql_public"],
    "extra_search_path": ["public", "extensions"],
    "max_rows": 1000
  },
  "db": {
    "port": 54322,
    "shadow_port": 54320,
    "major_version": 17,
    "health_timeout": "2m",
    "seed": {
      "enabled": false
    }
  },
  "studio": {
    "enabled": true,
    "port": 54323,
    "api_url": "http://127.0.0.1"
  },
  "local_smtp": {
    "enabled": true,
    "port": 54324
  },
  "auth": {
    "enabled": true,
    "site_url": "stockpilot://",
    "additional_redirect_urls": ["stockpilot://**"],
    "enable_signup": true,
    "jwt_expiry": 3600
  }
}
